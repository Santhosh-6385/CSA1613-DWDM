PROGRAM
# Enter the 18 age values
age <- c(...)

# Enter the 18 body fat values
fat <- c(...)

# Mean
cat("Mean of Age =", mean(age), "\n")
cat("Mean of Fat =", mean(fat), "\n")

# Median
cat("Median of Age =", median(age), "\n")
cat("Median of Fat =", median(fat), "\n")

# Standard Deviation
cat("SD of Age =", sd(age), "\n")
cat("SD of Fat =", sd(fat), "\n")

# Boxplots
boxplot(age, main="Boxplot of Age")
boxplot(fat, main="Boxplot of Body Fat")

# Scatter plot
plot(age, fat,
     main="Age vs Body Fat",
     xlab="Age",
     ylab="Body Fat")

# Q-Q plots
qqnorm(age)
qqline(age)

qqnorm(fat)
qqline(fat)

