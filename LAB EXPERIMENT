EXPERIMENT.02
 PROGRAM
age <- c(13,15,16,16,19,20,20,21,22,22,
         25,25,25,25,30,33,33,35,35,35,
         35,36,40,45,46,52,70)

# Mean
mean_age <- mean(age)

# Median
median_age <- median(age)

# Mode
mode_age <- as.numeric(names(sort(table(age), decreasing=TRUE)[1:2]))

# Midrange
midrange <- (min(age) + max(age)) / 2

# Quartiles
Q1 <- quantile(age, 0.25)
Q3 <- quantile(age, 0.75)

cat("Mean =", mean_age, "\n")
cat("Median =", median_age, "\n")
cat("Mode =", mode_age, "\n")
cat("Midrange =", midrange, "\n")
cat("Q1 =", Q1, "\n")
cat("Q3 =", Q3, "\n")

OUTPUT:Mean = 29.74074
Median = 25
Mode = 25 35
Midrange = 41.5
Q1 = 20
Q3 = 35
