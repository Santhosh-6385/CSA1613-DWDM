EXPERIMENT.04
PROGAM
data <- c(11,13,13,15,15,16,19,20,
          20,20,21,21,22,23,24,30,
          40,45,45,45,71,72,73,75)

# Divide into bins of 4
bins <- split(data, ceiling(seq_along(data)/4))

# Bin Mean
mean_smoothing <- unlist(
  lapply(bins, function(x) rep(mean(x), length(x)))
)

# Bin Median
median_smoothing <- unlist(
  lapply(bins, function(x) rep(median(x), length(x)))
)

# Bin Boundaries
boundary_smoothing <- unlist(
  lapply(bins, function(x) {
    lower <- min(x)
    upper <- max(x)
    sapply(x, function(v) {
      if(abs(v-lower) <= abs(v-upper))
        lower
      else
        upper
    })
  })
)

cat("Mean Smoothing:\n")
print(mean_smoothing)

cat("Median Smoothing:\n")
print(median_smoothing)

cat("Boundary Smoothing:\n")
print(boundary_smoothing)

